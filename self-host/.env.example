############
# ISGAPP + SUPABASE SELF-HOST PAKETİ
#
# Bu dosyayı `cp .env.example .env` ile kopyalayıp tüm şifreleri değiştirin.
# VEYA: `sh setup.sh` çalıştırın (tüm key'leri sizin için üretir).
#
# ⚠️ PRODUCTION'DA TÜM VARSAYILAN DEĞERLERİ DEĞİŞTİRMELİSİNİZ!
# Dokümantasyon:
# https://supabase.com/docs/guides/self-hosting/docker#configuring-and-securing-supabase
############

# Docker compose override dosyalarını katmanlamak için:
#   COMPOSE_FILE=docker-compose.yml
#   COMPOSE_FILE=docker-compose.yml:docker-compose.logs.yml
COMPOSE_FILE=docker-compose.yml


############
# Sırlar — İLK AÇILIŞTAN ÖNCE TÜM VARSAYILANLARI DEĞİŞTİRİN
############

# Postgres
POSTGRES_PASSWORD=your-super-secret-and-long-postgres-password

# Legacy simetrik HS256 key
JWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters-long
# Legacy API key'ler (HS256 imzalı JWT'ler)
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyAgCiAgICAicm9sZSI6ICJhbm9uIiwKICAgICJpc3MiOiAic3VwYWJhc2UtZGVtbyIsCiAgICAiaWF0IjogMTY0MTc2OTIwMCwKICAgICJleHAiOiAxNzk5NTM1NjAwCn0.dc_X5iR_VP_qT0zsiyj_I_OZ2T9FtRU2BBNWN8Bu4GE
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyAgCiAgICAicm9sZSI6ICJzZXJ2aWNlX3JvbGUiLAogICAgImlhdCI6IDE2NDE3NjkyMDAsCiAgICAiZXhwIjogMTc5OTUzNTYwMAp9.DaYlNEoUrrEn2Ig7tqibS-PHK5vgusbcbo7X36XVt4Q

# Asimetrik key çifti (ES256) ve opak API key'ler
# (setup.sh bunları otomatik üretir; elle de üretebilirsiniz:
#  sh ./utils/add-new-auth-keys.sh)
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
JWT_KEYS=
JWT_JWKS=

# Dashboard (Studio) erişimi
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=this_password_is_insecure_and_should_be_updated

# Realtime ve Supavisor iletişimini şifreleyen key
# (En az 64 karakter; üret: openssl rand -base64 48)
SECRET_KEY_BASE=UpNVntn3cDxHJpq99YMc1T1AQgQpc8kfYTuRgBiYa15BLrx8etQoXz3gZv1/u2oq

# Realtime `_realtime` şemasındaki hassas alanları şifreleyen key
# (Tam olarak 16 karakter; üret: openssl rand -hex 8)
REALTIME_DB_ENC_KEY=supabaserealtime

# Supavisor şifreli konfigürasyon key'i
# (Tam olarak 32 karakter; üret: openssl rand -hex 16)
VAULT_ENC_KEY=your-32-character-encryption-key

# Studio'nun postgres-meta bağlantılarını şifreleyen key
# (En az 32 karakter; üret: openssl rand -base64 24)
PG_META_CRYPTO_KEY=your-encryption-key-32-chars-min

# Logflare/Vector log token'ları (logs katmanı kullanılıyorsa)
LOGFLARE_PUBLIC_ACCESS_TOKEN=your-super-secret-and-long-logflare-key-public
LOGFLARE_PRIVATE_ACCESS_TOKEN=your-super-secret-and-long-logflare-key-private

# Storage S3 protokol endpoint erişimi
S3_PROTOCOL_ACCESS_KEY_ID=625729a08b95bf1b7ff351a663f3a23c
S3_PROTOCOL_ACCESS_KEY_SECRET=850181e4652dd023b7a98c58ae0d2d34bd487ee0cc3254aed6eda37307425907


############
# URL'ler — gerçek alan adınıza göre ayarlayın
############

# Dashboard ve REST API erişimi
SUPABASE_PUBLIC_URL=http://localhost:8000

# Auth servisinin tam dış URL'i (OAuth callback'leri, SAML, email linkleri)
API_EXTERNAL_URL=http://localhost:8000/auth/v1


############
# Veritabanı — Postgres konfigürasyonu
############

POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5432


############
# Supavisor — Veritabanı pooler'ı
############

POOLER_PROXY_PORT_TRANSACTION=6543
POOLER_DEFAULT_POOL_SIZE=20
POOLER_MAX_CLIENT_CONN=100
POOLER_TENANT_ID=your-tenant-id
POOLER_DB_POOL_SIZE=5


############
# Studio — Dashboard konfigürasyonu
############

STUDIO_DEFAULT_ORGANIZATION=Default Organization
STUDIO_DEFAULT_PROJECT=Default Project

# AI Assistant için OpenAI API key (opsiyonel)
OPENAI_API_KEY=sk-proj-xxxxxxxx


############
# Auth — Authentication sunucusu konfigürasyonu
############

SITE_URL=http://localhost:3000
ADDITIONAL_REDIRECT_URLS=

JWT_EXPIRY=3600
DISABLE_SIGNUP=false

MAILER_URLPATHS_CONFIRMATION="/auth/v1/verify"
MAILER_URLPATHS_INVITE="/auth/v1/verify"
MAILER_URLPATHS_RECOVERY="/auth/v1/verify"
MAILER_URLPATHS_EMAIL_CHANGE="/auth/v1/verify"

ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=false
SMTP_ADMIN_EMAIL=admin@example.com
SMTP_HOST=supabase-mail
SMTP_PORT=2500
SMTP_USER=fake_mail_user
SMTP_PASS=fake_mail_password
SMTP_SENDER_NAME=fake_sender
ENABLE_ANONYMOUS_USERS=false

ENABLE_PHONE_SIGNUP=true
ENABLE_PHONE_AUTOCONFIRM=true

# OAuth / Sosyal login sağlayıcıları (kullanıyorsanız yorumu kaldırın + compose'u düzenleyin)
# GOOGLE_ENABLED=false
# GOOGLE_CLIENT_ID=
# GOOGLE_SECRET=
# GITHUB_ENABLED=false
# GITHUB_CLIENT_ID=
# GITHUB_SECRET=
# AZURE_ENABLED=false
# AZURE_CLIENT_ID=
# AZURE_SECRET=

# SMS sağlayıcısı (kullanıyorsanız yorumu kaldırın + compose'u düzenleyin)
# SMS_PROVIDER=twilio
# SMS_OTP_EXP=60
# SMS_OTP_LENGTH=6
# SMS_MAX_FREQUENCY=60s
# SMS_TEMPLATE=Your code is {{ .Code }}
# SMS_TWILIO_ACCOUNT_SID=
# SMS_TWILIO_AUTH_TOKEN=
# SMS_TWILIO_MESSAGE_SERVICE_SID=
# SMS_TEST_OTP=

# MFA (varsayılanlar yeterliyse dokunmayın)
# MFA_TOTP_ENROLL_ENABLED=true
# MFA_TOTP_VERIFY_ENABLED=true
# MFA_PHONE_ENROLL_ENABLED=false
# MFA_PHONE_VERIFY_ENABLED=false
# MFA_MAX_ENROLLED_FACTORS=10

# SAML SSO (kullanıyorsanız yorumu kaldırın + compose'u düzenleyin)
# SAML_ENABLED=true
# SAML_PRIVATE_KEY=
# SAML_ALLOW_ENCRYPTED_ASSERTIONS=false
# SAML_RELAY_STATE_VALIDITY_PERIOD=2m0s
# SAML_EXTERNAL_URL=
# SAML_RATE_LIMIT_ASSERTION=15


############
# Storage — Storage konfigürasyonu
############

# 'file' backend'inde dizin adı, S3 backend'inde bucket
GLOBAL_S3_BUCKET=stub

# S3 protokol endpoint konfigürasyonu
REGION=stub

MINIO_ROOT_USER=supa-storage
MINIO_ROOT_PASSWORD=secret1234

# https://supabase.com/docs/guides/storage/s3/authentication#session-token
STORAGE_TENANT_ID=stub


############
# Functions — Edge function konfigürasyonu
############

FUNCTIONS_VERIFY_JWT=false


############
# API — PostgREST konfigürasyonu
############

PGRST_DB_SCHEMAS=public,graphql_public
PGRST_DB_MAX_ROWS=1000
PGRST_DB_EXTRA_SEARCH_PATH=public


############
# Logs ve Analytics (docker-compose.logs.yml katmanı kullanılıyorsa)
############

DOCKER_SOCKET_LOCATION=/var/run/docker.sock
# Podman: DOCKER_SOCKET_LOCATION=/run/podman/podman.sock
GOOGLE_PROJECT_ID=GOOGLE_PROJECT_ID
GOOGLE_PROJECT_NUMBER=GOOGLE_PROJECT_NUMBER


############
# API Gateway
############

KONG_HTTP_PORT=8000
KONG_HTTPS_PORT=8443

# Kong tarafından dahili kullanılır — istemci/sunucu kodunda KULLANMAYIN.
ANON_KEY_ASYMMETRIC=
SERVICE_ROLE_KEY_ASYMMETRIC=


############
# imgproxy
############

IMGPROXY_AUTO_WEBP=true


############
# TLS Proxy — Caddy/Nginx (opsiyonel, docker-compose.caddy.yml / .nginx.yml)
############

PROXY_DOMAIN=your-domain.example.com
CERTBOT_EMAIL=admin@example.com


############
# ISGAPP — Uygulama konfigürasyonu
############

# isgapp tarayıcıya hangi host/port üzerinden sunulacak
# (Kong'dan DEĞİL, doğrudan isgapp servisinden servis edilir)
ISGAPP_HTTP_PORT=3000

# İsteğe bağlı — isgapp'i Kong üzerinden de sunabilirsiniz:
# NEXT_PUBLIC_SUPABASE_URL=http://localhost:8000
# NEXT_PUBLIC_SUPABASE_ANON_KEY=${ANON_KEY}

# Backup API anahtarı (yedekleme uç noktası için; `backup.sh` bunu kullanır)
BACKUP_API_KEY=your-backup-api-key

# isgapp auth katmanı (pg) bağlantısı — varsayılan db servisine işaret eder.
# Veritabanı şifresi POSTGRES_PASSWORD değişkeninden otomatik alınır;
# özel bir değer kullanacaksanız buraya tam bağlantı dizesi yazın.
# DATABASE_URL=postgresql://postgres:PAROLA@db:5432/postgres
